<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="712.0" prefWidth="1049.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo6.Controller.AdminScene.Page.BookManageTableController">
   <children>
      <TableView fx:id="tableView" layoutY="53.0" prefHeight="700.0" prefWidth="1049.0" styleClass="table" stylesheets="@../../../Style/AdminScene/BookTable.css">
         <columns>
            <TableColumn fx:id="tf_ISBN" prefWidth="139.0" text="ISBN" />
            <TableColumn fx:id="tf_Title" prefWidth="234.0" text="Title" />
            <TableColumn fx:id="tf_author" prefWidth="164.0" text="Author" />
            <TableColumn fx:id="tf_category" prefWidth="174.0" text="Category" />
            <TableColumn fx:id="tf_language" prefWidth="113.0" text="Language" />
            <TableColumn fx:id="tf_publisher" prefWidth="139.0" text="Publisher" />
            <TableColumn fx:id="tf_quantity" prefWidth="84.0" text="Quantity" />
         </columns>
      </TableView>
      <HBox alignment="CENTER" layoutX="-16.0" prefHeight="52.0" prefWidth="399.0" stylesheets="@../../../Style/AdminScene/AddUser.css">
         <children>
            <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#addBook" text="Thêm sách" />
            <Button mnemonicParsing="false" onAction="#deleteBook" text="Xóa sách">
               <HBox.margin>
                  <Insets left="20.0" right="20.0" />
               </HBox.margin></Button>
            <Button mnemonicParsing="false" onAction="#loadData" text="Load" />
         </children>
      </HBox>
   </children>
</AnchorPane>
