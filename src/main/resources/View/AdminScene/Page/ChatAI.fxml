         <TextField fx:id="userInput" alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onKeyPressed="#Enter" prefHeight="60.0" prefWidth="1055.0" promptText="Enter your message...">
