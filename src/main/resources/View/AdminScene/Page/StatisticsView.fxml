<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo6.Controller.AdminScene.Page.Statistics">
    <VBox spacing="20" layoutX="10" layoutY="10">
        <Label text="Library Statistics" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- Pie Chart for Book Categories -->
        <PieChart fx:id="bookCategoryChart" prefHeight="250" prefWidth="400" />

        <!-- Bar Chart for Number of Users and Books -->
        <BarChart fx:id="userBookBarChart" prefHeight="300" prefWidth="400">
            <xAxis>
                <CategoryAxis fx:id="xAxis" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" />
            </yAxis>
        </BarChart>
    </VBox>
</AnchorPane>
