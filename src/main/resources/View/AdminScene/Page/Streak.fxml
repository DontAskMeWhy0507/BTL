<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo6.Controller.AdminScene.Page.Streak">

    <!-- Header -->
    <Label layoutX="200.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Your Streak" />

    <!-- Progress bar to show streak progress -->
    <ProgressBar fx:id="streakProgressBar" layoutX="100.0" layoutY="100.0" prefWidth="400.0" style="-fx-accent: #76c7c0;" />

    <!-- Streak information -->
    <Label fx:id="streakLabel" layoutX="100.0" layoutY="150.0" style="-fx-font-size: 16px;" />
    <Label fx:id="longestStreakLabel" layoutX="100.0" layoutY="180.0" style="-fx-font-size: 16px;" />
    <Label fx:id="milestoneLabel" layoutX="100.0" layoutY="210.0" style="-fx-font-size: 16px; -fx-font-style: italic;" />

    <!-- Reward message -->
    <Label fx:id="rewardLabel" layoutX="100.0" layoutY="250.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: green;" />

</AnchorPane>

