<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXCheckBox?>
<?import com.jfoenix.controls.JFXRippler?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="switchScene" prefHeight="720.0" prefWidth="1182.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo6.Controller.LoginScene.LoginController">
   <AnchorPane fx:id="mainPane" prefHeight="720.0" prefWidth="1182.0" stylesheets="@../../Style/LoginScene/Login.css">
      <children>
         <TextField fx:id="tf_username" layoutX="100.0" layoutY="218.0" onKeyPressed="#Enter" prefHeight="73.0" prefWidth="416.0" promptText="Tên đăng nhập" styleClass="tf_username" stylesheets="@../../Style/LoginScene/Login.css">
            <font>
               <Font size="20.0" />
            </font>
         </TextField>
         <PasswordField fx:id="tf_password" layoutX="100.0" layoutY="323.0" onKeyPressed="#Enter" prefHeight="74.0" prefWidth="416.0" promptText="Mật khẩu" styleClass="tf_username" stylesheets="@../../Style/LoginScene/Login.css">
            <font>
               <Font size="20.0" />
            </font>
         </PasswordField>
         <Button fx:id="buttonLogin" layoutX="205.0" layoutY="480.0" mnemonicParsing="false" onAction="#loginToHome" prefHeight="52.0" prefWidth="205.0" styleClass="buttonLogin" stylesheets="@../../Style/LoginScene/Login.css" text="Đăng nhập" />
         <Text fx:id="WelcomeText" layoutX="53.0" layoutY="139.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="WelcomeText" text="Welcome back!" wrappingWidth="509.9999999999999">
            <font>
               <Font size="35.0" />
            </font>
         </Text>
         <JFXCheckBox fx:id="remember" checkedColor="#aab396" layoutX="107.0" layoutY="424.0" styleClass="remember" stylesheets="@../../Style/LoginScene/Login.css" text="Remember me" />
         <JFXButton fx:id="buttonForgotPassword" layoutX="232.0" layoutY="602.0" onAction="#loadForgotPassword" styleClass="buttonForgotPassword" stylesheets="@../../Style/LoginScene/Login.css" text="Quên mật khẩu?" />
         <JFXRippler fx:id="loginRippler" layoutX="204.0" layoutY="480.0" prefHeight="52.0" prefWidth="206.0" styleClass="loginRippler" stylesheets="@../../Style/LoginScene/Login.css" />
         <Text layoutX="184.0" layoutY="581.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="normalText" text="Chưa có tài khoản?" wrappingWidth="152.0" />
         <JFXButton fx:id="buttonSignUp" alignment="BOTTOM_CENTER" layoutX="336.0" layoutY="560.0" onAction="#loadSignUp" prefHeight="31.0" prefWidth="90.0" styleClass="switchRegister" stylesheets="@../../Style/LoginScene/Login.css" text="Đăng ký">
            <font>
               <Font size="20.0" />
            </font></JFXButton>
         <TextField fx:id="showPassword" disable="true" layoutX="100.0" layoutY="323.0" prefHeight="74.0" prefWidth="416.0" styleClass="showPassword" stylesheets="@../../Style/LoginScene/Login.css" visible="false" />
         <JFXCheckBox fx:id="showPass" checkedColor="#aab396" layoutX="354.0" layoutY="424.0" onAction="#getPassword" styleClass="remember" stylesheets="@../../Style/LoginScene/Login.css" text="Hiển thị mật khẩu" />
      </children>
   </AnchorPane>
   <ImageView fx:id="img" fitHeight="734.0" fitWidth="597.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../../Image/temp_lib.jpg" />
      </image>
      <StackPane.margin>
         <Insets left="602.0" />
      </StackPane.margin>
   </ImageView>
</StackPane>
