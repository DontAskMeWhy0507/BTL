<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.demo6.Controller.AdminScene.Page.ChatAIController"
            prefHeight="400.0" prefWidth="600.0">

    <!-- Main Layout -->
    <VBox spacing="10.0" alignment="TOP_CENTER" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0"
          AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

        <!-- Chat Display -->
        <ScrollPane prefHeight="300.0" prefWidth="580.0">
            <TextArea fx:id="chatDisplay" editable="false" wrapText="true" prefHeight="300.0" prefWidth="580.0" />
        </ScrollPane>

        <!-- Input and Send Button -->
        <HBox spacing="10.0" alignment="CENTER">
            <TextField fx:id="userInput" promptText="Enter your message..." HBox.hgrow="ALWAYS" />
            <Button text="Send" onAction="#handleSendMessage" />
        </HBox>
    </VBox>
</AnchorPane>
