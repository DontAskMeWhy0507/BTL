<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1000.0" spacing="20.0" stylesheets="@../../../Style/AdminScene/PageSearch.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo6.Controller.UserScene.Page.SearchPageController">
    <!-- Title for Database results section -->
    <Label text="Database Search Results" />

    <!-- Database results section -->
    <GridPane fx:id="databaseResults" prefWidth="1000.0" VBox.vgrow="ALWAYS">
        <!-- Database search results will be added here dynamically -->
    </GridPane>

    <!-- Title for API results section -->
    <Label text="API Search Results" />

    <!-- API results section -->
    <GridPane fx:id="apiResults" prefWidth="537.0" VBox.vgrow="ALWAYS">
        <!-- API search results will be added here dynamically -->
    </GridPane>
</VBox>
