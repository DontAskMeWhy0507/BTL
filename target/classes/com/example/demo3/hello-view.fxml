<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="619.0" prefWidth="927.0" spacing="20.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo3.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <AnchorPane prefHeight="618.0" prefWidth="870.0">
      <children>
         <Button layoutX="766.0" layoutY="514.0" mnemonicParsing="false" onAction="#onAbc123" text="DUng bam" />
         <Label fx:id="welcomeText1" layoutX="785.0" layoutY="488.0" text="HELLO" />
         <ChoiceBox fx:id="myChoiceBox" layoutX="641.0" layoutY="218.0" prefWidth="150.0" />
         <Label fx:id="myLabel" layoutX="580.0" layoutY="166.0" prefHeight="46.0" prefWidth="272.0" text="Select what you want to eat">
            <font>
               <Font name="Arial Bold" size="20.0" />
            </font>
         </Label>
         <DatePicker fx:id="datePicker" layoutX="644.0" layoutY="91.0" onAction="#datePicker" promptText="Enter date" />
         <Label layoutX="644.0" layoutY="54.0" prefHeight="26.0" prefWidth="209.0" text="Select a date" />
         <Label fx:id="selectedDate" layoutX="641.0" layoutY="130.0" prefHeight="39.0" prefWidth="216.0" text="Selected Date" />
         <ComboBox layoutX="60.0" layoutY="117.0" prefWidth="150.0" promptText="Chaha" />
         <ImageView fx:id="myImageView" fitHeight="150.0" fitWidth="200.0" layoutX="43.0" layoutY="166.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@meme.jpg" />
            </image>
         </ImageView>
         <Button fx:id="myButton" layoutX="109.0" layoutY="288.0" mnemonicParsing="false" onAction="#displayImage" text="Button" />
         <MenuBar layoutX="-2.0" layoutY="1.0" prefHeight="26.0" prefWidth="887.0">
           <menus>
             <Menu mnemonicParsing="false" text="File">
               <items>
                     <Menu mnemonicParsing="false" text="New">
                       <items>
                           <MenuItem mnemonicParsing="false" onAction="#newMethod" text="C++" />
                         <MenuItem mnemonicParsing="false" text="Java Class" />
                           <SeparatorMenuItem mnemonicParsing="false" />
                           <MenuItem mnemonicParsing="false" text="Close" />
                       </items>
                     </Menu>
                     <Menu mnemonicParsing="false" text="Open">
                        <items>
                         <MenuItem mnemonicParsing="false" text="File" />
                           <MenuItem mnemonicParsing="false" text="Folder" />
                        </items>
                     </Menu>
                     <MenuItem mnemonicParsing="false" text="Save">
                        <accelerator>
                           <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                        </accelerator>
                     </MenuItem>
                     <MenuItem mnemonicParsing="false" text="Save As">
                        <accelerator>
                           <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="DOWN" shortcut="UP" />
                        </accelerator>
                     </MenuItem>
               </items>
             </Menu>
             <Menu mnemonicParsing="false" text="Edit">
               <items>
                 <MenuItem mnemonicParsing="false" text="Delete" />
               </items>
             </Menu>
             <Menu mnemonicParsing="false" text="Help">
               <items>
                 <MenuItem mnemonicParsing="false" text="About" />
               </items>
             </Menu>
               <Menu mnemonicParsing="false" text="View">
                 <items>
                     <CheckMenuItem mnemonicParsing="false" text="Special Mode" />
                     <RadioMenuItem mnemonicParsing="false" text="Split up">
                        <toggleGroup>
                           <ToggleGroup fx:id="mySplit" />
                        </toggleGroup>
                     </RadioMenuItem>
                     <RadioMenuItem mnemonicParsing="false" text="Split down" toggleGroup="$mySplit" />
                 </items>
               </Menu>
           </menus>
         </MenuBar>
         <MediaView fitHeight="200.0" fitWidth="200.0" layoutX="262.0" layoutY="320.0" />
      </children>
   </AnchorPane>
</VBox>
